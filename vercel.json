{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }]
    },
    {
      "source": "/js/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/styles.css",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/app.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ],
  "rewrites": [
    { "source": "/pedido/:token", "destination": "/api" },
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/assets/uploads/:path*", "destination": "/api" },
    { "source": "/brasil/pedido", "destination": "/api" },
    { "source": "/brasil", "destination": "/api" },
    { "source": "/admin", "destination": "/api" },
    { "source": "/login", "destination": "/api" },
    { "source": "/", "destination": "/api" }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "{data.js,agosto-2026-capital-prices.json,multilupo-prices.json,catalogs.json,index.html,admin.html,login.html,pedido-brasil.html,styles.css,app.js,logo.svg,js/**,lib/**,orders/**}",
      "excludeFiles": "{pdfs,tmp_pdf_text}/**"
    }
  }
}
