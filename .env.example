# Obligatorio en Vercel: texto aleatorio de 32+ caracteres (firma las cookies de sesión).
# Generalo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Opcional: clave del usuario "admin" que se crea SOLO si la base no tiene usuarios.
# Si no se define, se genera una al azar y se muestra una vez en la consola.
# ADMIN_PASSWORD=

# Obligatorio en Vercel (y opcional en local para compartir la misma base):
# GITHUB_TOKEN=ghp_xxx
# GITHUB_REPO=arieljarovisky/catalogo_lupo_web
# GITHUB_BRANCH=data
