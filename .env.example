# Local: sin variables, usa db.json en disco.

# Producción (Vercel) — obligatorio para que usuarios/precios no se borren:
# 1. GitHub → Settings → Developer settings → Fine-grained token
# 2. Repo: catalogo_lupo_web · Permissions: Contents Read and write
# 3. Pegá el token en Vercel → Environment Variables
GITHUB_TOKEN=ghp_xxx
GITHUB_REPO=arieljarovisky/catalogo_lupo_web
GITHUB_BRANCH=data

SESSION_SECRET=cambia-esto-por-un-texto-largo-aleatorio
